# Dependencies and generated output
node_modules/
dist/
coverage/

# Logs
logs/
*.log

# Local environment secrets (keep the example trackable)
.env
.env.*
!.env.example

# OS clutter
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# Local npm configuration (may contain registry credentials)
.npmrc
.npmrc.local

# Local editor state; retain useful shared project configuration
/.vscode/settings.json
/.vscode/*.local.json
/.idea/workspace.xml
/.idea/tasks.xml
/.idea/dataSources.local.xml
/.idea/shelf/
/.vs/
*.local.code-workspace
